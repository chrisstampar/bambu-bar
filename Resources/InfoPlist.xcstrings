    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar najde vaši tiskárnu Bambu Lab ve vaší síti a čte její stav přímo z ní, bez jakékoli cloudové služby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar findet Ihren Drucker von Bambu Lab im Netzwerk und liest seinen Status direkt von ihm aus, ohne Cloud-Dienst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bambu Bar finds your Bambu Lab printer on your network and reads its status directly from it, without any cloud service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar encuentra su impresora Bambu Lab en la red y lee su estado directamente de ella, sin ningún servicio en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar trouve votre imprimante Bambu Lab sur votre réseau et lit son état directement depuis celle-ci, sans aucun service cloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Bambu Bar megkeresi a Bambu Lab nyomtatót a hálózaton, és közvetlenül tőle olvassa ki az állapotát, felhőszolgáltatás nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar trova la tua stampante Bambu Lab sulla rete e ne legge lo stato direttamente, senza alcun servizio cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Barは、ネットワーク上のBambu Labプリンターを検出し、クラウドサービスを使わずにプリンターから直接ステータスを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar는 네트워크에서 Bambu Lab 프린터를 찾아 클라우드 서비스 없이 프린터에서 직접 상태를 읽어 옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar vindt uw Bambu Lab-printer op uw netwerk en leest de status rechtstreeks uit, zonder clouddienst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar znajduje Twoją drukarkę Bambu Lab w sieci i odczytuje jej stan bezpośrednio z niej, bez żadnej usługi w chmurze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Bambu Bar encontra sua impressora Bambu Lab na rede e lê o estado diretamente dela, sem nenhum serviço de nuvem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar находит ваш принтер Bambu Lab в сети и считывает его статус напрямую, без облачных сервисов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bambu Bar hittar din Bambu Lab-skrivare i ditt nätverk och läser dess status direkt från den, utan någon molntjänst."
